# The shared fonts' stand-ins compiled into the runtime (hle/services/pl.c, which uses them when a game folder has no
# fonts/ of its own): snx_font_standard, Open Sans 1.101, for every slot but FontNintendoExtended, and
# snx_font_extended, yuzu's controller button glyphs, for that one, as Eden carries them. cmake/dependencies.cmake
# fetches both; the glyphs come as the C++ byte array Eden's source holds them in, so their bytes are read out of it
include_guard(GLOBAL)
file(GLOB snx_open_sans "${OpenSans_SOURCE_DIR}/*.ttf")
file(GLOB snx_oss_ext "${YuzuOSSExtension_SOURCE_DIR}/*.cpp")
if(NOT snx_open_sans OR NOT snx_oss_ext)
    message(FATAL_ERROR "The shared fonts' stand-ins are missing (${OpenSans_SOURCE_DIR}, ${YuzuOSSExtension_SOURCE_DIR})")
endif()
file(READ "${snx_open_sans}" snx_font_hex HEX)
string(LENGTH "${snx_font_hex}" snx_font_standard_size)
math(EXPR snx_font_standard_size "${snx_font_standard_size} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," snx_font_standard_bytes "${snx_font_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " snx_font_standard_bytes "${snx_font_standard_bytes}")
file(READ "${snx_oss_ext}" snx_font_src)
string(FIND "${snx_font_src}" "{{" snx_font_at)
string(SUBSTRING "${snx_font_src}" ${snx_font_at} -1 snx_font_src)
string(REGEX MATCHALL "0x[0-9a-fA-F][0-9a-fA-F]" snx_font_list "${snx_font_src}")
list(LENGTH snx_font_list snx_font_extended_size)
if(snx_font_extended_size LESS 12)
    message(FATAL_ERROR "${snx_oss_ext} holds no font")
endif()
list(JOIN snx_font_list "," snx_font_extended_bytes)
string(REGEX REPLACE "((0x[0-9a-fA-F][0-9a-fA-F],){20})" "\\1\n    " snx_font_extended_bytes "${snx_font_extended_bytes}")
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/shared_fonts.c" @ONLY CONTENT
"/* Generated by cmake/shared_fonts.cmake from Open Sans 1.101 (Apache 2.0) and yuzu's YuzuOSSExtension
   (GPL-2.0-or-later). Do not edit. */
#include <stddef.h>
extern const unsigned char snx_font_standard[], snx_font_extended[];
extern const size_t snx_font_standard_size, snx_font_extended_size;
const unsigned char snx_font_standard[] = {
    @snx_font_standard_bytes@
};
const size_t snx_font_standard_size = @snx_font_standard_size@;
const unsigned char snx_font_extended[] = {
    @snx_font_extended_bytes@
};
const size_t snx_font_extended_size = @snx_font_extended_size@;
")
