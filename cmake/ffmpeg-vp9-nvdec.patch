# FFmpeg's VP9 decoder fed by NVDEC jobs (gpu/video/nvdec.c, gpu/video/vp9_rebuild.cpp; fuddlesworth's, #297), so each
# job decodes at its own fence, as NVDEC does, instead of a job later. NVDEC says whether a picture was shown only in
# the next job's setup, and hands each picture its whole probability table. A context whose opaque starts with the u32
# 0x534e5856 ("SNXV", NvdecCtx) takes the previous picture's visibility from the u32 after it, which the picture's
# motion vector prediction depends on, and starts each picture from the default probabilities, which the rebuilt
# compressed header moves to NVDEC's table. Any other context decodes as released.
#
# cmake/ffmpeg.cmake applies it to a copy of the release and checks the result. To change it, edit a copy of the
# pristine file, rebuild the hunks with `diff -u --label a/<file> --label b/<file>`, and update the hash there.
--- a/libavcodec/vp9.c
+++ b/libavcodec/vp9.c
@@ -553,6 +553,8 @@
     s->s.h.keyframe   = !get_bits1(&s->gb);
 
     last_invisible   = s->s.h.invisible;
+    if (avctx->opaque && ((const unsigned int *)avctx->opaque)[0] == 0x534e5856)
+        last_invisible = ((const unsigned int *)avctx->opaque)[1];
     s->s.h.invisible = !get_bits1(&s->gb);
     s->s.h.errorres  = get_bits1(&s->gb);
     s->s.h.use_last_frame_mvs = !s->s.h.errorres && !last_invisible;
@@ -893,6 +895,14 @@
                sizeof(ff_vp9_default_coef_probs));
     }
 
+    if (avctx->opaque && ((const unsigned int *)avctx->opaque)[0] == 0x534e5856) {
+        for (int snx_i = 0; snx_i < 4; snx_i++) {
+            s->prob_ctx[snx_i].p = ff_vp9_default_probs;
+            memcpy(s->prob_ctx[snx_i].coef, ff_vp9_default_coef_probs,
+                   sizeof(ff_vp9_default_coef_probs));
+        }
+    }
+
     // next 16 bits is size of the rest of the header (arith-coded)
     s->s.h.compressed_header_size = size2 = get_bits(&s->gb, 16);
     s->s.h.uncompressed_header_size = (get_bits_count(&s->gb) + 7) / 8;
